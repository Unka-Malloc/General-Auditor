      },
      "submit_readiness": "A Styio compiler version is submittable when `platform-adaptation / linux-ci-gate`, `test / smoke`, and `test / golden-standard` all pass.",
      "golden_standard_suite": {
        "manifest": "docs/specs/GOLDEN-STANDARD-TEST-SUITE.md",
        "required_files": [
