          "docs/design/syntax/SYNTAX-CONVERGENCE-MATRIX.json",
          "scripts/syntax-convergence-gate.py"
        ],
        "required_markers": {
          "docs/specs/GOLDEN-STANDARD-TEST-SUITE.md": [
            "test / smoke",
            "test / golden-standard",
            "syntax-convergence-gate.py",
            "submit readiness"
          ],
          "docs/design/syntax/SYNTAX-CONVERGENCE-MATRIX.json": [
            "\"schema_version\": 1",
            "\"features\"",
            "\"implementation\""
          ],
          "scripts/syntax-convergence-gate.py": [
            "exactly one implementation",
            "golden_cases"
          ]
        }
      },
      "industry_gate_groups": {
        "language / compiler-quality": {
          "covered_by": "test / golden-standard",
          "industry_references": [
            "LLVM Testing Infrastructure Guide: unit, regression, lit/FileCheck, and whole-program tests",
            "Rust Compiler Development Guide: compiler test suites and UI tests",
            "OpenSSF Scorecard: CI tests, fuzzing, branch protection, binary artifacts"
          ],
          "required_markers": [
            "syntax convergence",
            "parser shadow",
            "five-layer",
            "milestone",
            "fuzz",
            "golden cases"
          ]
        }
      },
      "local_gate_profile": {
        "profile_id": "styio-syntax-convergence-profile",
        "manifest": "docs/specs/GOLDEN-STANDARD-TEST-SUITE.md",
        "covered_by": "test / golden-standard",
        "required_markers": [
