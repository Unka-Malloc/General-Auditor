{
  "schema_version": 1,
  "repository": "SymPolicy/styio.io",
  "additional_rule_groups": [
    "code",
    "dependencies",
    "workflows"
  ],
  "required_paths": [],
  "local_review": [
    "Review privacy and credential findings in context before the first push.",
    "Review every outgoing commit, not only the final working tree.",
    "Review public product claims and documented language behavior for consistency.",
    "Review static assets, embedded scripts and forms for credential or visitor-data exposure."
  ],
  "category": "website",
  "repository_policy": {
    "require_workflow": true,
    "hygiene_profile": "styio-default",
    "resource_contracts": [
      {
        "id": "website_release_surface",
        "owner": "Website and Release Hosting",
        "description": "Owns public website pages, release-root metadata, static assets, and Pages workflows.",
        "scope_globs": [
          "index.html",
          "404.html",
          "docs/**",
          "assets/**",
          "scripts/**",
          "tools/**",
          ".github/workflows/**",
          "release-index.json",
          "CNAME"
        ],
        "copying_policy": "Website content may publish public release metadata but must not expose private signing material, deployment credentials, or unpublished backend endpoints.",
        "concurrency_policy": "Release-root metadata, generated pages, and deployment workflows should update as one auditable release surface.",
        "nullability_policy": "Missing website entrypoints or release index makes the public release surface incomplete.",
        "cleanup_policy": "Generated site packages and local deploy credentials must stay outside tracked source.",
        "state_machine": {
          "source": "Website and release-root lifecycle.",
          "states": [
            "authored",
            "validated",
            "deployed"
          ],
          "transitions": [
            {
              "from": "authored",
              "to": "validated",
              "on": "site smoke and release-root validation"
            },
            {
              "from": "validated",
              "to": "deployed",
              "on": "GitHub Pages deployment"
            }
          ],
          "invalid_operations": [
            "publish private signing material",
            "deploy release metadata without validation"
          ]
        },
        "required_tests": [
          "site smoke test and release-root validation"
        ],
        "required_gates": [
          "styio-audit common gate",
          "Pages deployment gate"
        ],
        "audit_risks": [
          "release metadata drift",
          "DNS configuration leakage",
          "private deployment material exposure"
        ]
      }
    ],
    "project_inventory": {
      "audit_profile": "static-website",
      "technology_stack": [
        "Static HTML/CSS/JavaScript website",
        "GitHub Pages",
        "Release-root packaging scripts"
      ],
      "internal_components": [
        "marketing_site",
        "documentation_pages",
        "release_root_manifest",
        "pages_workflows",
        "static_assets"
      ],
      "open_source_components": [
        "Browser JavaScript",
        "GitHub Pages",
        "Shell packaging scripts"
      ],
      "dependency_manifests": [
        "README.md",
        "release-index.json"
      ]
    },
    "defect_records": {
      "root": "docs/audit/defects",
      "required_audit_fields": [
        "**Severity:**",
        "**Evidence:**",
        "**Test evidence:**",
        "**Data lifecycle:**",
        "**Gate impact:**",
        "**Required closure:**"
      ],
      "required_closure_fields": [
        "**Closure evidence:**",
        "**Coverage evidence:**",
        "**Data lifecycle evidence:**",
        "**Gate evidence:**"
      ],
      "closed_statuses": [
        "closed",
        "resolved",
        "cleared"
      ]
    },
    "ci_contract": {
      "test_gates": {
        "smoke": "test / smoke",
        "golden_standard": "test / golden-standard"
      },
      "submit_readiness": "A styio.io version is submittable when `test / smoke` and `test / golden-standard` both pass.",
      "golden_standard_suite": {
        "manifest": "docs/specs/GOLDEN-STANDARD-TEST-SUITE.md",
        "required_files": [
          "docs/specs/GOLDEN-STANDARD-TEST-SUITE.md"
        ],
        "required_markers": {
          "docs/specs/GOLDEN-STANDARD-TEST-SUITE.md": [
            "test / smoke",
            "test / golden-standard",
            "submit readiness"
          ]
        }
      },
      "industry_gate_groups": {
        "website / release-root": {
          "covered_by": "test / golden-standard",
          "industry_references": [
            "GitHub rulesets: branch, tag, and push restrictions for protected release surfaces",
            "OpenSSF Scorecard: CI tests and binary-artifact hygiene before merge"
          ],
          "required_markers": [
            "static site",
            "release-root validation",
            "install docs",
            "release index",
            "hosted tool entrypoints"
          ]
        }
      },
      "local_gate_profile": {
        "profile_id": "styio-io-release-root-site-profile",
        "manifest": "docs/specs/GOLDEN-STANDARD-TEST-SUITE.md",
        "covered_by": "test / golden-standard",
        "required_markers": [
          "repo-owned adaptation",
          "release-root validation",
          "release index",
          "hosted tool entrypoints",
          "install docs"
        ]
      }
    }
  },
  "privacy_policy": {
    "privacy_ip_allowlist": [
      {
        "service": "github-pages-apex-dns",
        "ips": [
          "185.199.108.153",
          "185.199.109.153",
          "185.199.110.153",
          "185.199.111.153",
          "2606:50c0:8000::153",
          "2606:50c0:8001::153",
          "2606:50c0:8002::153",
          "2606:50c0:8003::153"
        ],
        "path_globs": [
          "docs/dns-and-pages.html",
          "docs/**/dns-and-pages.html",
          "modules/default/module.json"
        ]
      }
    ]
  }
}
