{
  "name": "Auditor branch lifecycle",
  "target": "branch",
  "enforcement": "active",
  "bypass_actors": [],
  "conditions": {
    "ref_name": {
      "include": [
        "~ALL"
      ],
      "exclude": [
        "refs/heads/only",
        "refs/heads/work/*"
      ]
    }
  },
  "rules": [
    {
      "type": "creation"
    }
  ]
}
